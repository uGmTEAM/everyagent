    <a href="/media" class="<%= active === 'media' ? 'on' : '' %>">生图语音</a>
    <a href="/tasks" class="<%= active === 'tasks' ? 'on' : '' %>">任务表</a>
    <a href="/corpus" class="<%= active === 'corpus' ? 'on' : '' %>">公共语料</a>
    <a href="/deaths" class="<%= active === 'deaths' ? 'on' : '' %>">死亡档案</a>
    <a href="/logs" class="<%= active === 'logs' ? 'on' : '' %>">日志</a>
