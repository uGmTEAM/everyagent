<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · EveryAgent</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
<header class="topbar">
  <div class="brand">EveryAgent</div>
  <nav>
    <a href="/" class="<%= active === 'overview' ? 'on' : '' %>">总览</a>
