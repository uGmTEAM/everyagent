<%- include('partials/header') %>

<h1>预设工具</h1>

<% if (message) { %>
  <div class="notice ok"><%= message %></div>
<% } %>
<% if (error) { %>
  <div class="notice error"><%= error %></div>
<% } %>

<div class="panel">
  <p class="muted small">上传 GitHub release 的压缩包（.zip / .tar.gz / .tgz / .tar）。平台解压到 <code>data/toolkits/&lt;名称&gt;/</code>；创建 AI 时可勾选，以只读方式挂载到容器 <code>/opt/toolkits/&lt;名称&gt;</code>，<code>bin/</code> 下的可执行文件会自动复制到 <code>/usr/local/bin</code> 并加入 PATH。</p>
  <p class="muted small">可选：在工具集根目录放 <code>toolkit.json</code>，例如 <code>{"version":"1.0.0","description":"B 站命令行客户端","bin":["bin"],"commands":["bilic"]}</code>，用于在创建页显示版本与说明。</p>
  <form method="post" action="/toolkits" enctype="multipart/form-data">
    <div class="row">
      <div>
        <label>工具集名称（可选，默认取压缩包文件名）</label>
        <input name="name" placeholder="例如 bilic">
      </div>
      <div>
        <label>压缩包</label>
        <input type="file" name="archive" accept=".zip,.tar.gz,.tgz,.tar" required>
      </div>
    </div>
    <p style="margin-top:12px"><button type="submit">上传并解压</button></p>
  </form>
</div>

<% if (list.length) { %>
  <div class="table-wrap">
    <table>
      <thead>
        <tr><th>名称</th><th>版本</th><th>说明</th><th>命令</th><th>大小</th><th>操作</th></tr>
      </thead>
      <tbody>
        <% list.forEach(function (t) { %>
          <tr>
            <td><%= t.name %></td>
            <td><%= t.version || '-' %></td>
            <td class="small"><%= t.description || '-' %></td>
            <td class="small"><%= t.commands.join('、') || '-' %></td>
            <td><%= fmtBytes(t.bytes) %></td>
            <td>
              <form method="post" action="/toolkits/<%= t.name %>/delete" onsubmit="return confirm('删除工具集 <%= t.name %>？已挂载的 AI 容器需要重建后才失效。')">
                <button type="submit" class="danger">删除</button>
              </form>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
<% } else { %>
  <div class="notice">还没有工具集。上传一个 GitHub release 压缩包即可。</div>
<% } %>

<%- include('partials/footer') %>
