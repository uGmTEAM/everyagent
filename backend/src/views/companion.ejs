<%- include('partials/header') %>

<% if (message) { %>
  <div class="notice ok"><%= message %></div>
<% } %>
<% if (error) { %>
  <div class="notice error"><%= error %></div>
<% } %>

<% if (mode === 'list') { %>
  <h1>陪伴总览</h1>
  <p class="muted small">
    陪伴 AI 通过 QQ 与人对话：私聊必回，群聊只在被 @ 时回复。AI 崩溃时容器会连同 QQ 一起关闭；QQ 进程崩溃不计入 AI 崩溃次数，由平台自动重启/切换。
  </p>

  <% if (!list.length) { %>
    <div class="panel">
      <p>还没有陪伴 AI。到 <a href="/agents/new?mode=companion">创建陪伴 AI</a> 添加一个，创建后固定为无限额度、启用虚拟屏、崩溃重启上限 5 次。</p>
    </div>
  <% } else { %>
    <div class="companion-cards">
      <% list.forEach(function (a) { %>
        <% var b = bindings[a.id] || {}; %>
        <div class="companion-card">
          <div class="companion-card-head">
            <a class="companion-card-title" href="/companion/<%= a.id %>"><%= a.id %></a>
            <span class="badge <%= statusClass(a.status) %>"><%= statusText(a.status) %></span>
          </div>
          <div class="companion-card-body">
            <div class="meta-row"><span class="k">QQ</span><span><%= b.uin || '未登录' %></span></div>
            <div class="meta-row"><span class="k">通讯桥</span><span><%= b.bridge_ready ? '就绪' : (b.last_error ? '异常' : '未连接') %></span></div>
            <div class="meta-row"><span class="k">QQ 重启</span><span><%= fmtInt(b.qq_restarts || 0) %> 次</span></div>
            <div class="meta-row"><span class="k">会话</span><span><%= fmtInt(a.conversations || 0) %></span></div>
            <div class="meta-row"><span class="k">收 / 发</span><span><%= fmtInt(a.incoming || 0) %> / <%= fmtInt(a.outgoing || 0) %></span></div>
            <div class="meta-row"><span class="k">模型</span><span><%= a.model %></span></div>
            <div class="meta-row"><span class="k">最后消息</span><span><%= a.last_message_at ? fmtDate(a.last_message_at) : '无' %></span></div>
          </div>
          <div class="companion-card-actions">
            <a class="btn" href="/companion/<%= a.id %>">进入面板</a>
            <% if (a.status === 'created' || a.status === 'suspended') { %>
              <form class="inline" method="post" action="/agents/<%= a.id %>/start">
                <button class="light" type="submit"><%= a.status === 'suspended' ? '恢复启动' : '启动' %></button>
              </form>
            <% } %>
            <% if (a.status === 'paused_disk') { %>
              <form class="inline" method="post" action="/agents/<%= a.id %>/resume">
                <button class="light" type="submit">恢复</button>
              </form>
            <% } %>
          </div>
        </div>
      <% }); %>
    </div>
  <% } %>

  <% var managerList = (typeof managers !== 'undefined' && managers) ? managers : []; %>
  <div class="panel manager-panel">
    <h2>管理者账号登记</h2>
    <p class="muted small">
      QQ 或邮箱消息只有与这里登记的账号一致时才视为管理者（账号本身无法伪装，不用选类型，含 @ 自动识别为邮箱）。创建 AI 时也能填入，或在「设置」页统一维护。AI 通过平台核实身份后，也可以用 manager_register 工具补充登记。
    </p>
    <% if (!managerList.length) { %>
      <p class="muted small">还没有登记任何账号。建议先登记你自己的 QQ 号与邮箱。</p>
    <% } else { %>
      <table class="manager-table">
        <thead>
          <tr><th>类型</th><th>账号</th><th>备注</th><th>来源</th><th>登记时间</th><th></th></tr>
        </thead>
        <tbody>
          <% managerList.forEach(function (m) { %>
            <tr>
              <td><span class="badge"><%= m.kind === 'qq' ? 'QQ' : '邮箱' %></span></td>
              <td><code><%= m.account_id %></code></td>
              <td><%= m.label || '' %><% if (m.note) { %><br><span class="muted small"><%= m.note %></span><% } %></td>
              <td><%= m.source === 'ai' ? 'AI 登记' : '平台登记' %></td>
              <td class="muted small"><%= fmtDate(m.created_at) %></td>
              <td>
                <form class="inline" method="post" action="/managers/<%= m.id %>/delete">
                  <button class="light" type="submit">删除</button>
                </form>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    <% } %>
    <form class="manager-form" method="post" action="/managers">
      <input name="account_id" placeholder="QQ 号或邮箱（含 @ 视为邮箱）" required>
      <input name="label" placeholder="备注名（可选）">
      <input name="note" placeholder="说明（可选）">
      <button type="submit">登记</button>
    </form>
  </div>
<% } else { %>
  <% var b = binding || {}; %>
  <% var crashed = agent.status === 'suspended'; %>
  <% var offline = agent.status === 'running' && !b.logged_in; %>
  <div class="companion-shell">
    <aside class="companion-side">
      <div class="companion-side-head">
        <a class="companion-agent" href="/companion/<%= agent.id %>"><%= agent.id %></a>
        <span class="badge <%= statusClass(agent.status) %>" id="agent-status-badge"><%= statusText(agent.status) %></span>
      </div>
      <div class="companion-side-meta">
        <div class="meta-row"><span class="k">模型</span><span data-meta="model"><%= agent.model %></span></div>
        <div class="meta-row"><span class="k">QQ</span><span data-meta="qq"><%= b.uin || '未登录' %></span></div>
        <div class="meta-row"><span class="k">重启上限</span><span><%= crashLimit === null ? '不限' : crashLimit + ' 次' %></span></div>
        <div class="meta-row"><span class="k">会话</span><span data-meta="conversations"><%= fmtInt(stats.conversations) %></span></div>
        <div class="meta-row"><span class="k">收 / 发</span><span data-meta="inout"><%= fmtInt(stats.incoming) %> / <%= fmtInt(stats.outgoing) %></span></div>
      </div>

      <h3>会话</h3>
      <div class="conversation-list" id="conversation-list">
        <% if (!conversations.length) { %>
          <div class="muted small">还没有收到消息。</div>
        <% } %>
        <% conversations.forEach(function (c) { %>
          <% var active = c.conversation_id === activeConversation; %>
          <a class="conversation-item <%= active ? 'on' : '' %>"
             href="/companion/<%= agent.id %>?conversation=<%= encodeURIComponent(c.conversation_id) %>">
            <div class="conversation-name">
              <span><%= c.conversation_name || c.conversation_id %></span>
              <span class="badge"><%= c.conversation_kind === 'group' ? '群' : c.conversation_kind === 'channel' ? '频道' : c.conversation_kind === 'system' ? '提醒' : '私聊' %></span>
            </div>
            <div class="conversation-meta">
              <span><%= fmtInt(c.message_count) %> 条</span>
              <span><%= fmtDate(c.last_at) %></span>
            </div>
          </a>
        <% }); %>
      </div>

      <div class="companion-side-links">
        <a href="/companion">返回总览</a>
        <a href="/agents/<%= agent.id %>">AI 详情</a>
        <a href="<%= noVncUrl %>" target="_blank" rel="noopener">打开虚拟桌面</a>
      </div>
    </aside>

    <section class="companion-main">
      <div class="companion-topbar">
        <div class="companion-topbar-left">
          <span class="badge <%= b.logged_in ? 'status-running' : 'status-created' %>" id="qq-badge">QQ <%= b.logged_in ? '在线' : '离线' %></span>
          <span class="muted small" id="bridge-text">通讯桥 <%= b.bridge_ready ? '就绪' : '未连接' %> · QQ 重启 <%= fmtInt(b.qq_restarts || 0) %> 次</span>
        </div>
        <div class="companion-topbar-right">
          <button class="light" type="button" id="qr-button">二维码</button>
          <form class="inline" method="post" action="/companion/<%= agent.id %>/qq-restart">
            <button class="light" type="submit">重启 QQ</button>
          </form>
        </div>
      </div>

      <% if (crashed) { %>
        <div class="alert-bar">
          <strong>陪伴 AI 已暂停自动重启。</strong>
          连续 <%= crashLimit === null ? '多' : crashLimit %> 次重启失败，平台已停止拉起该容器。修复后可点下方「恢复启动」。排查信息可在 <a href="/inbox">信息</a> 查看。
        </div>
      <% } else if (offline) { %>
        <div class="alert-bar">
          <strong>QQ 离线。</strong>
          平台会自动重启/切换 QQ 进程，通常无需处理；若长时间离线，点右上「二维码」扫码登录，或手动「重启 QQ」。
        </div>
      <% } %>
      <% if (b.last_error) { %>
        <div class="notice error small">最近错误：<%= b.last_error %></div>
      <% } %>

      <div class="hint-bar">
        提示：AI 崩溃时容器会连同 QQ 一起关闭（QQ 无法脱离 AI 单独运行）；QQ 进程崩溃不影响 AI，平台会自动重启或切换账号。
      </div>

      <div class="hint-bar" id="keyword-bar" style="display:none">
        群聊命中词：<span id="keyword-list"></span>
        <span class="muted small">（由 AI 自己设置，命中即按被点名处理）</span>
      </div>

      <% if (crashed) { %>
        <div class="panel">
          <form method="post" action="/agents/<%= agent.id %>/start">
            <button type="submit">恢复启动</button>
          </form>
        </div>
      <% } %>

      <div class="companion-chat" id="chat-list">
        <% if (!activeConversation) { %>
          <div class="chat-empty">选择左侧会话查看聊天记录。</div>
        <% } else if (!messages.length) { %>
          <div class="chat-empty">该会话还没有消息。</div>
        <% } %>
        <% messages.forEach(function (m) { %>
          <div class="chat-row <%= m.direction === 'in' ? 'incoming' : 'outgoing' %>">
            <div class="chat-bubble">
              <div class="chat-meta">
                <span class="chat-who"><%= m.direction === 'in' ? (m.sender_name || m.sender_uin || '对方') : (agent.id + ' · AI') %></span>
                <span class="chat-time"><%= fmtDate(m.created_at) %></span>
                <% if (m.direction === 'in' && !m.needs_reply) { %>
                  <span class="badge">未触发</span>
                <% } %>
                <% if (m.trigger_word) { %>
                  <span class="badge">命中词：<%= m.trigger_word %></span>
                <% } %>
                <% if (m.conversation_id === '__reminder__') { %>
                  <span class="badge badge-reminder">定时提醒</span>
                <% } %>
              </div>
              <div class="chat-content"><%= m.content %></div>
            </div>
          </div>
        <% }); %>
      </div>

      <% var activeMeta = conversations.find(function (c) { return c.conversation_id === activeConversation; }) || {}; %>
      <% var activeKind = activeMeta.conversation_kind || 'private'; %>
      <form class="companion-composer" method="post" action="/companion/<%= agent.id %>/send">
        <input type="hidden" name="conversation_id" value="<%= activeConversation %>">
        <input type="hidden" name="kind" id="send-kind" value="<%= activeKind %>">
        <input type="hidden" name="reply_to" value="">
        <textarea name="text" rows="3" placeholder="<%= activeKind === 'system' ? '平台提醒会话，仅 AI 自己使用，不能回复' : '以管理员身份向该会话发送消息（不影响 AI 的自动回复）' %>" required <%= activeKind === 'system' ? 'disabled' : '' %>></textarea>
        <div class="composer-actions">
          <span class="muted small">会话：<%= activeConversation || '未选择' %></span>
          <button type="submit" <%= activeConversation && activeKind !== 'system' ? '' : 'disabled' %>>发送</button>
        </div>
      </form>
    </section>
  </div>

  <dialog id="qr-dialog">
    <div class="qr-box">
      <h3>扫码登录 QQ</h3>
      <div class="qr-image" id="qr-image"><span class="muted small">加载中…</span></div>
      <p class="muted small" id="qr-text">使用手机 QQ 扫描二维码。</p>
      <form method="dialog"><button class="light">关闭</button></form>
    </div>
  </dialog>

  <script>
    (function () {
      var kindInput = document.getElementById('send-kind');
      var conversationInput = document.querySelector('.companion-composer input[name="conversation_id"]');
      var kindValue = conversationInput ? conversationInput.value : '';
      // 会话类型来自服务端渲染的隐藏值，缺失时按私聊处理。
      if (kindInput && !kindInput.value) kindInput.value = 'private';

      var qrButton = document.getElementById('qr-button');
      var qrDialog = document.getElementById('qr-dialog');
      var qrImage = document.getElementById('qr-image');
      var qrText = document.getElementById('qr-text');
      if (qrButton && qrDialog) {
        qrButton.addEventListener('click', function () {
          qrImage.innerHTML = '<span class="muted small">加载中…</span>';
          qrText.textContent = '使用手机 QQ 扫描二维码。';
          qrDialog.showModal();
          fetch('/companion/<%= agent.id %>/qrcode')
            .then(function (res) { return res.json().then(function (data) { return { ok: res.ok, data: data }; }); })
            .then(function (result) {
              if (!result.ok) throw new Error((result.data.error && result.data.error.message) || '获取二维码失败');
              var base64 = result.data.qr_base64 || '';
              if (!base64) throw new Error('二维码为空，QQ 可能已登录或未就绪');
              qrImage.innerHTML = '<img alt="QQ 二维码" src="data:image/png;base64,' + base64 + '">';
              if (result.data.qr_url) qrText.textContent = '扫码地址：' + result.data.qr_url;
            })
            .catch(function (err) {
              qrImage.innerHTML = '<span class="error-text">' + err.message + '</span>';
            });
        });
      }

      // 实时刷新：每 4 秒拉一次状态，只替换变化的部分，不打断正在输入的内容。
      var agentId = <%- JSON.stringify(agent.id) %>;
      var activeConversation = <%- JSON.stringify(activeConversation || '') %>;
      var lastConversationSig = '';
      var lastMessageSig = '';
      var lastRenderedConversation = null;

      function fmtInt(value) {
        return Number(value || 0).toLocaleString('en-US');
      }

      function kindText(kind) {
        if (kind === 'group') return '群';
        if (kind === 'channel') return '频道';
        if (kind === 'system') return '提醒';
        return '私聊';
      }

      function setMeta(key, text) {
        var node = document.querySelector('[data-meta="' + key + '"]');
        if (node) node.textContent = text;
      }

      function renderConversations(data) {
        var list = document.getElementById('conversation-list');
        if (!list) return;
        var sig = JSON.stringify([data.conversations, data.active_conversation]);
        if (sig === lastConversationSig) return;
        lastConversationSig = sig;
        list.innerHTML = '';
        if (!data.conversations.length) {
          var empty = document.createElement('div');
          empty.className = 'muted small';
          empty.textContent = '还没有收到消息。';
          list.appendChild(empty);
          return;
        }
        data.conversations.forEach(function (item) {
          var link = document.createElement('a');
          link.className = 'conversation-item' + (item.id === data.active_conversation ? ' on' : '');
          link.href = '/companion/' + encodeURIComponent(agentId) + '?conversation=' + encodeURIComponent(item.id);
          var head = document.createElement('div');
          head.className = 'conversation-name';
          var name = document.createElement('span');
          name.textContent = item.name || item.id;
          var badge = document.createElement('span');
          badge.className = 'badge';
          badge.textContent = kindText(item.kind);
          head.appendChild(name);
          head.appendChild(badge);
          var meta = document.createElement('div');
          meta.className = 'conversation-meta';
          var count = document.createElement('span');
          count.textContent = fmtInt(item.count) + ' 条';
          var time = document.createElement('span');
          time.textContent = item.last_text || '';
          meta.appendChild(count);
          meta.appendChild(time);
          link.appendChild(head);
          link.appendChild(meta);
          list.appendChild(link);
        });
      }

      function renderMessages(data) {
        var chat = document.getElementById('chat-list');
        if (!chat) return;
        var sig = JSON.stringify(data.messages);
        if (sig === lastMessageSig) return;
        lastMessageSig = sig;
        var nearBottom = chat.scrollHeight - chat.scrollTop - chat.clientHeight < 80;
        var conversationChanged = data.active_conversation !== lastRenderedConversation;
        lastRenderedConversation = data.active_conversation;
        chat.innerHTML = '';
        if (!data.active_conversation) {
          var empty = document.createElement('div');
          empty.className = 'chat-empty';
          empty.textContent = '选择左侧会话查看聊天记录。';
          chat.appendChild(empty);
          return;
        }
        if (!data.messages.length) {
          var empty2 = document.createElement('div');
          empty2.className = 'chat-empty';
          empty2.textContent = '该会话还没有消息。';
          chat.appendChild(empty2);
          return;
        }
        data.messages.forEach(function (message) {
          var row = document.createElement('div');
          row.className = 'chat-row ' + (message.direction === 'in' ? 'incoming' : 'outgoing');
          var bubble = document.createElement('div');
          bubble.className = 'chat-bubble';
          var meta = document.createElement('div');
          meta.className = 'chat-meta';
          var who = document.createElement('span');
          who.className = 'chat-who';
          who.textContent = message.who;
          var time = document.createElement('span');
          time.className = 'chat-time';
          time.textContent = message.time || '';
          meta.appendChild(who);
          meta.appendChild(time);
          if (message.direction === 'in' && !message.needs_reply) {
            var skipped = document.createElement('span');
            skipped.className = 'badge';
            skipped.textContent = '未触发';
            meta.appendChild(skipped);
          }
          if (message.trigger_word) {
            var hit = document.createElement('span');
            hit.className = 'badge';
            hit.textContent = '命中词：' + message.trigger_word;
            meta.appendChild(hit);
          }
          if (message.reminder) {
            var reminder = document.createElement('span');
            reminder.className = 'badge badge-reminder';
            reminder.textContent = '定时提醒';
            meta.appendChild(reminder);
          }
          var content = document.createElement('div');
          content.className = 'chat-content';
          content.textContent = message.content || '';
          bubble.appendChild(meta);
          bubble.appendChild(content);
          row.appendChild(bubble);
          chat.appendChild(row);
        });
        // 进入页面或切换会话时直接到底部；只有用户正在看历史时才保持当前位置
        if (conversationChanged || nearBottom) chat.scrollTop = chat.scrollHeight;
      }

      function renderKeywords(data) {
        var bar = document.getElementById('keyword-bar');
        var list = document.getElementById('keyword-list');
        if (!bar || !list) return;
        var items = Array.isArray(data.keywords) ? data.keywords : [];
        if (!items.length) {
          bar.style.display = 'none';
          return;
        }
        bar.style.display = 'block';
        list.textContent = items
          .map(function (item) { return item.word + (item.scope === 'group' ? '（本群）' : ''); })
          .join('、');
      }

      function applyLive(data) {
        var statusBadge = document.getElementById('agent-status-badge');
        if (statusBadge) {
          statusBadge.className = 'badge ' + data.status_class;
          statusBadge.textContent = data.status_text;
        }
        var qqBadge = document.getElementById('qq-badge');
        if (qqBadge) {
          qqBadge.className = 'badge ' + (data.binding.logged_in ? 'status-running' : 'status-created');
          qqBadge.textContent = 'QQ ' + (data.binding.logged_in ? '在线' : '离线');
        }
        var bridge = document.getElementById('bridge-text');
        if (bridge) {
          bridge.textContent = '通讯桥 ' + (data.binding.bridge_ready ? '就绪' : '未连接') + ' · QQ 重启 ' + fmtInt(data.binding.qq_restarts) + ' 次';
        }
        setMeta('model', data.model);
        setMeta('qq', data.binding.uin || '未登录');
        setMeta('conversations', fmtInt(data.stats.conversations));
        setMeta('inout', fmtInt(data.stats.incoming) + ' / ' + fmtInt(data.stats.outgoing));
        if (data.binding.logged_in) {
          document.querySelectorAll('.alert-bar').forEach(function (node) {
            if (node.textContent.indexOf('QQ 离线') >= 0) node.remove();
          });
        }
        renderConversations(data);
        renderKeywords(data);
        renderMessages(data);
      }

      function tick() {
        if (document.hidden) return;
        var url = '/companion/' + encodeURIComponent(agentId) + '/live?conversation=' + encodeURIComponent(activeConversation);
        fetch(url, { headers: { Accept: 'application/json' } })
          .then(function (res) { if (!res.ok) throw new Error('HTTP ' + res.status); return res.json(); })
          .then(applyLive)
          .catch(function () {});
      }

      tick();
      setInterval(tick, 4000);

      // 首次进入页面时服务端已渲染消息，直接滚到底部，避免每次手动翻
      var initialChat = document.getElementById('chat-list');
      if (initialChat) initialChat.scrollTop = initialChat.scrollHeight;
    })();
  </script>
<% } %>

<%- include('partials/footer') %>
